                                                @:👤
                                            }
                                        </div>
                                        <div class="ts-meta">
                                            <div class="ts-name">@author</div>
                                            @if (showRole && !string.IsNullOrEmpty(role)) {
                                                <div class="ts-role">@role</div>
                                            }
                                            <div class="ts-stars">
                                                @for (int i = 0; i < 5; i++) {
                                                    <span style="color:@(i < rating ? "#f1c40f" : "#ddd")">★</span>
