@model WebsiteBuilder.Models.Page
@using System.Text.Json;
@inject WebsiteBuilder.Data.AppDbContext DbContext

@{
    Layout = null; // Clean preview without ASP.NET layout
    var allPages = DbContext.Pages.OrderBy(p => p.Id).ToList();
    
    // Helper to determine text color based on background
    bool IsLight(string hex)
    {
        if (string.IsNullOrEmpty(hex) || hex.Length < 7) return true;
        try {
            int r = Convert.ToInt32(hex.Substring(1, 2), 16);
            int g = Convert.ToInt32(hex.Substring(3, 2), 16);
            int b = Convert.ToInt32(hex.Substring(5, 2), 16);
            return (r * 299 + g * 587 + b * 114) / 1000 > 128;
        } catch { return true; }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Name - Preview</title>
    <meta name="description" content="A page built with PageBuilder">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/preview.css" />
</head>
<body>

@foreach (var block in Model.Blocks)
{
    var d = JsonDocument.Parse(block.DataJson).RootElement;
    
    if (block.BlockType == "topbar")
    {
        string tickerText = d.TryGetProperty("tickerText", out var tt) ? tt.GetString() : "";
           bool isScrolling = false;

            if (d.TryGetProperty("isScrolling", out var s))
            {
                if (s.ValueKind == JsonValueKind.String)
                {
                    bool.TryParse(s.GetString(), out isScrolling);
                    if (!isScrolling)
                        isScrolling = s.GetString() == "1";
                }
                else if (s.ValueKind == JsonValueKind.True || s.ValueKind == JsonValueKind.False)
                {
                    isScrolling = s.GetBoolean();
                }
            }

        string email = d.TryGetProperty("email", out var em) ? em.GetString() : "";
        string phone = d.TryGetProperty("phone", out var ph) ? ph.GetString() : "";
        string bg = d.TryGetProperty("bg", out var bgc) ? bgc.GetString() : "#a6111f";
        string accentBg = d.TryGetProperty("accentBg", out var abg) ? abg.GetString() : "#800d18";
        string textColor = d.TryGetProperty("textColor", out var tc) ? tc.GetString() : "#ffffff";
        string scrollClass = isScrolling ? "is-scrolling" : "";

        <div class="b-topbar" style="background:@bg; color:@textColor">
            <div class="topbar-left @scrollClass">
                <div class="topbar-ticker">@tickerText</div>
            </div>
            <div class="topbar-right" style="background:@accentBg">
                <div class="topbar-contact">
                    <span>✉ @email</span>
                    <span>📞 @phone</span>
                </div>
            </div>
        </div>
    }
    else if (string.Equals(block.BlockType, "navbar", StringComparison.OrdinalIgnoreCase))
    {
        string bg = d.TryGetProperty("bg", out var b) ? b.GetString() : "#ffffff";
        string logoImage = d.TryGetProperty("logoImage", out var limg) ? limg.GetString() : "";
        string logoText = d.TryGetProperty("logo", out var lt) ? lt.GetString() : "Brand";
        string logoColor = d.TryGetProperty("logoColor", out var lc) ? lc.GetString() : "#111111";
        string linksPos = d.TryGetProperty("linksPos", out var lp) ? lp.GetString() : "right";
        string linksColor = d.TryGetProperty("linksColor", out var lcolor) ? lcolor.GetString() : "#777777";
        int linksSize = d.TryGetProperty("linksSize", out var lsize) ? lsize.GetInt32() : 14;
        bool linksBold = d.TryGetProperty("linksBold", out var lbold) ? lbold.GetBoolean() : false;
        bool linksItalic = d.TryGetProperty("linksItalic", out var lital) ? lital.GetBoolean() : false;
        string linkStyle = $"color:{linksColor}; font-size:{linksSize}px; font-weight:{(linksBold ? "bold" : "normal")}; font-style:{(linksItalic ? "italic" : "normal")};";

        string paddingVStr = d.TryGetProperty("paddingV", out var pv) ? pv.ToString() : "18";
        int paddingV = 18; int.TryParse(paddingVStr, out paddingV);

        <!-- Navbar v2.1 Responsive -->
        <div class="b-navbar pos-@(linksPos)" style="background:@(bg); padding-top:@(paddingV)px; padding-bottom:@(paddingV)px">
            <div class="nav-logo">
                @if(!string.IsNullOrEmpty(logoImage)) {
                    <img src="@logoImage" alt="@logoText" style="max-height:40px">
                } else {
                    <span style="color:@logoColor">@logoText</span>
                }
            </div>
            <button class="nav-toggle" onclick="this.parentElement.querySelector('.nav-links').classList.toggle('active')">☰</button>
            <div class="nav-links">
                @if(allPages.Any()) {
                    foreach(var p in allPages) {
                        <a href="/page/@(p.Slug)" style="color:inherit; text-decoration:none; @(linkStyle)">@(p.Name)</a>
                    }
                } else {
                    <span style="@linkStyle">Home</span><span style="@linkStyle">About</span><span style="@linkStyle">Services</span>
                }
            </div>
        </div>
    }
    else if (block.BlockType == "hero")
    {
        string bg = d.TryGetProperty("bg", out var el) ? el.GetString() : "#1a1a2e";
        string paddingVStr = d.TryGetProperty("paddingV", out var pv) ? pv.ToString() : "80";
        int paddingV = 80; int.TryParse(paddingVStr, out paddingV);

        <div class="b-hero" style="background:@(bg); padding-top:@(paddingV)px; padding-bottom:@(paddingV)px">
            <h1>@(d.GetProperty("heading").GetString())</h1>
            <p>@(d.GetProperty("subtext").GetString())</p>
            @{
                string btnLink = d.TryGetProperty("btnLink", out var bl) ? bl.GetString() : "#";
                string btnUrl = (btnLink.StartsWith("http") || btnLink.StartsWith("/") || btnLink == "#") ? btnLink : $"/page/{btnLink}";
            }
            <a href="@btnUrl" style="text-decoration:none"><button class="hero-btn">@(d.GetProperty("btnText").GetString())</button></a>
        </div>
    }
    else if (block.BlockType == "herosplit")
    {
        string bg = d.TryGetProperty("bg", out var el) ? el.GetString() : "#0d252a";
        string imgSrc = d.TryGetProperty("imgSrc", out var isrc) ? isrc.GetString() : "";
        string btnLink = d.TryGetProperty("btnLink", out var bl) ? bl.GetString() : "#";
        string btnUrl = (btnLink.StartsWith("http") || btnLink.StartsWith("/") || btnLink == "#") ? btnLink : $"/page/{btnLink}";
        string paddingVStr = d.TryGetProperty("paddingV", out var pv) ? pv.ToString() : "100";
        int paddingV = 100; int.TryParse(paddingVStr, out paddingV);

        <div class="b-herosplit" style="background:@(bg)">
            <div class="herosplit-visual" style="@(!string.IsNullOrEmpty(imgSrc) ? $"background-image:linear-gradient(rgba(13,37,42,0.3), rgba(13,37,42,0.3)), url('{imgSrc}');" : "")"></div>
            <div class="herosplit-content" style="padding-top:@(paddingV)px; padding-bottom:@(paddingV)px">
                <h1>@(d.GetProperty("heading").GetString())</h1>
                <p>@(d.GetProperty("subtext").GetString())</p>
                <a href="@(btnUrl)" style="text-decoration:none">
                    <button class="hero-btn">@(d.GetProperty("btnText").GetString())</button>
                </a>
            </div>
        </div>
    }
    else if (block.BlockType == "textbanner") // Text Banner
    {
        string bg = d.TryGetProperty("bg", out var el) ? el.GetString() : "#5b4fff";
        bool isLight = IsLight(bg);
        string color = isLight ? "#111" : "#fff";
        <div class="b-textbanner" style="background:@bg;color:@color">
            <h2>@(d.GetProperty("heading").GetString())</h2>
            <p>@(d.GetProperty("subtext").GetString())</p>
            <div class="tb-actions">
                @{
                    string btnPrimaryLink = d.TryGetProperty("btnLink", out var bl1) ? bl1.GetString() : "#";
                    string btnPrimaryUrl = (btnPrimaryLink.StartsWith("http") || btnPrimaryLink.StartsWith("/") || btnPrimaryLink == "#") ? btnPrimaryLink : $"/page/{btnPrimaryLink}";
                }
                <a href="@btnPrimaryUrl" style="text-decoration:none">
                    <button class="btn-primary" style="color:@color; border-color:@(isLight ? "rgba(0,0,0,0.15)" : "rgba(255,255,255,0.4)")">@(d.TryGetProperty("btnPrimary", out var b1) ? b1.GetString() : "Start free")</button>
                </a>
                <button class="btn-secondary" style="color:@color; border-color:@(isLight ? "rgba(0,0,0,0.15)" : "transparent")">@(d.TryGetProperty("btnSecondary", out var b2) ? b2.GetString() : "Learn more")</button>
            </div>
        </div>
    }
    else if (block.BlockType == "text")
    {
        <div class="b-text">
            <h2>@(d.GetProperty("heading").GetString())</h2>
            <p>@(d.GetProperty("body").GetString())</p>
        </div>
    }
    else if (block.BlockType == "imgtext")
    {
        string bg = d.TryGetProperty("bg", out var bgEl) ? bgEl.GetString() : "#ffffff";
        string layout = d.TryGetProperty("layout", out var layEl) ? layEl.GetString() : "left";
        string textAlign = d.TryGetProperty("textAlign", out var alignEl) ? alignEl.GetString() : "left";
        string imgPos = d.TryGetProperty("imgPosition", out var posEl) ? posEl.GetString() : "center";
        string imgSrc = d.TryGetProperty("imgSrc", out var srcEl) ? srcEl.GetString() : "";
        
        <div class="b-imgtext img-@layout" style="background:@bg">
            <div class="imgtext-img">
                @if(!string.IsNullOrEmpty(imgSrc)){
                    <img src="@imgSrc" style="object-position:@imgPos" alt="" />
                } else {
                    <div class="placeholder">Image Placeholder</div>
                }
            </div>
            <div class="imgtext-body" style="text-align:@textAlign">
                <div class="it-tag">@(d.TryGetProperty("tag", out var tEl) ? tEl.GetString() : "Featured")</div>
                <h2>@(d.GetProperty("heading").GetString())</h2>
                <p>@(d.GetProperty("body").GetString())</p>
                @{
                    string itBtnLink = d.TryGetProperty("btnLink", out var bl2) ? bl2.GetString() : "#";
                    string itBtnUrl = (itBtnLink.StartsWith("http") || itBtnLink.StartsWith("/") || itBtnLink == "#") ? itBtnLink : $"/page/{itBtnLink}";
                }
                <a href="@itBtnUrl" style="text-decoration:none"><button class="it-btn">@(d.GetProperty("btnText").GetString())</button></a>
            </div>
        </div>
    }
    else if (block.BlockType == "gridimgtext" || block.BlockType == "gridimgtextrow")
    {
        // Both grid types are very similar, we can reuse logic here
        bool isRow = block.BlockType == "gridimgtextrow";
        
        string cols = d.TryGetProperty("cols", out var colsEl) ? colsEl.GetString() : "3";
        string bg = isRow && d.TryGetProperty("cardBg", out var bgEl) ? bgEl.GetString() : (d.TryGetProperty("cardBg", out var cg) ? cg.GetString() : "#fff");
        string titleColor = d.TryGetProperty("titleColor", out var tc) ? tc.GetString() : "#111";
        string descColor = d.TryGetProperty("descColor", out var dc) ? dc.GetString() : "#666";
        string tagColor = d.TryGetProperty("tagColor", out var gc) ? gc.GetString() : "#888";
        string textAlign = d.TryGetProperty("textAlign", out var ta) ? ta.GetString() : "left";
        string layout = d.TryGetProperty("imgLayout", out var il) ? il.GetString() : "top";
        string imgPos = d.TryGetProperty("imgPosition", out var ip) ? ip.GetString() : "center";
        
        <div class="@(isRow ? "b-gridimgtextrow" : "b-gridimgtext")">
            <div class="git-header">
                <h2>@(d.GetProperty("heading").GetString())</h2>
                <p>@(d.GetProperty("subtext").GetString())</p>
            </div>
            <div class="@(isRow ? "gitrow-grid" : "git-grid") cols-@cols">
                @if(d.TryGetProperty("items", out var items) && items.ValueKind == JsonValueKind.Array)
                {
                    foreach(var item in items.EnumerateArray())
                    {
                        string iSrc = item.TryGetProperty("imgSrc", out var iS) ? iS.GetString() : "";
                        <div class="@(isRow ? $"gitrow-card img-{layout}" : "git-card")" style="background:@bg">
                            <div class="@(isRow ? "gitrow-card-img" : "git-card-img")">
                                @if(!string.IsNullOrEmpty(iSrc)){
                                    <img src="@iSrc" style="object-position:@imgPos" alt="" />
                                }
                            </div>
                            <div class="@(isRow ? "gitrow-card-body" : "git-card-body")" style="text-align:@textAlign">
                                <span class="@(isRow ? "gr-tag" : "git-tag")" style="color:@tagColor; background:@(tagColor)18;">@(item.TryGetProperty("tag", out var it) ? it.GetString() : "")</span>
                                <h3 style="color:@titleColor">@(item.TryGetProperty("title", out var itit) ? itit.GetString() : "")</h3>
                                <p style="color:@descColor">@(item.TryGetProperty("desc", out var idesc) ? idesc.GetString() : "")</p>
                                @if(isRow) {
                                    string itLink = item.TryGetProperty("btnLink", out var bl3) ? bl3.GetString() : "#";
                                    string itUrl = (itLink.StartsWith("http") || itLink.StartsWith("/") || itLink == "#") ? itLink : $"/page/{itLink}";
                                    <a href="@itUrl" style="text-decoration:none"><button class="gr-btn">@(item.TryGetProperty("btnText", out var bt) ? bt.GetString() : "Learn more")</button></a>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
    else if (block.BlockType == "features")
    {
        <div class="b-features">
            <h2>@(d.GetProperty("heading").GetString())</h2>
            <div class="feat-grid">
                @if(d.TryGetProperty("items", out var feats) && feats.ValueKind == JsonValueKind.Array){
                    foreach(var f in feats.EnumerateArray()){
                        <div class="feat-card">
                            <div class="feat-icon">@(f.TryGetProperty("icon", out var fi) ? fi.GetString() : "✦")</div>
                            <h3>@(f.TryGetProperty("title", out var ft) ? ft.GetString() : "")</h3>
                            <p>@(f.TryGetProperty("desc", out var fd) ? fd.GetString() : "")</p>
                        </div>
                    }
                }
            </div>
        </div>
    }
    else if (block.BlockType == "cta")
    {
        string bg = d.TryGetProperty("bg", out var el) ? el.GetString() : "#5b4fff";
        <div class="b-cta" style="background:@bg">
            <h2>@(d.GetProperty("heading").GetString())</h2>
            <p>@(d.GetProperty("subtext").GetString())</p>
            @{
                string ctaLink = d.TryGetProperty("btnLink", out var bl4) ? bl4.GetString() : "#";
                string ctaUrl = (ctaLink.StartsWith("http") || ctaLink.StartsWith("/") || ctaLink == "#") ? ctaLink : $"/page/{ctaLink}";
            }
            <a href="@ctaUrl" style="text-decoration:none"><button style="color:@bg">@(d.GetProperty("btnText").GetString())</button></a>
        </div>
    }
    else if (block.BlockType == "testimonial")
    {
        string heading = d.TryGetProperty("heading", out var h) ? h.GetString() : "Testimonials";
        string bg = d.TryGetProperty("bg", out var b) ? b.GetString() : "#f0f7ff";
        string paddingVStr = d.TryGetProperty("paddingV", out var pv) ? pv.ToString() : "80";
        int.TryParse(paddingVStr, out int paddingV);
        int blockId = block.Id;

        <div class="b-testimonial-slider" id="slider-@(blockId)" style="background:@bg; padding-top:@(paddingV)px; padding-bottom:@(paddingV)px">
            <div class="ts-header">
                <div class="ts-line"></div>
                <h2>@heading</h2>
                <div class="ts-line"></div>
            </div>
            <div class="ts-viewport">
                <div class="ts-track">
                    @if (d.TryGetProperty("items", out var items) && items.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var item in items.EnumerateArray())
                        {
                            string author = item.TryGetProperty("author", out var auth) ? auth.GetString() : "";
                            string role = item.TryGetProperty("role", out var r) ? r.GetString() : "";
                            string quote = item.TryGetProperty("quote", out var q) ? q.GetString() : "";
                            string imgSrc = item.TryGetProperty("imgSrc", out var isrc) ? isrc.GetString() : "";
                            int rating = item.TryGetProperty("rating", out var rate) ? rate.GetInt32() : 5;
                            string initials = string.Join("", author.Split(' ').Select(s => s.FirstOrDefault())).ToUpper();
                            if (initials.Length > 2) initials = initials.Substring(0, 2);

                            <div class="ts-item">
                                <div class="ts-card">
                                    <div class="ts-author-row">
                                        <div class="ts-avatar">
                                            @if (!string.IsNullOrEmpty(imgSrc)) {
                                                <img src="@imgSrc" alt="@author">
                                            } else {
                                                @initials
                                            }
                                        </div>
                                        <div class="ts-meta">
                                            <div class="ts-name">@author</div>
                                            <div class="ts-stars">
                                                @for (int i = 0; i < 5; i++) {
                                                    <span style="color:@(i < rating ? "#f1c40f" : "#ddd")">★</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="ts-quote-box">
                                        <span class="ts-quote-icon">“</span>
                                        <p class="ts-quote-text">@quote</p>
                                        <span class="ts-quote-icon ts-quote-end">”</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="ts-dots">
                @if (d.TryGetProperty("items", out var itemsDots) && itemsDots.ValueKind == JsonValueKind.Array)
                {
                    int i = 0;
                    foreach (var item in itemsDots.EnumerateArray())
                    {
                        <div class="ts-dot @(i == 0 ? "active" : "")" onclick="jumpSlider(@blockId, @(i++))"></div>
                    }
                }
            </div>
        </div>
    }
    else if (block.BlockType == "form")
    {
        <div class="b-form">
            <h2>@(d.GetProperty("heading").GetString())</h2>
            <div class="form-row">
                <div class="form-field"><label>First name</label><input type="text" placeholder="Jane"></div>
                <div class="form-field"><label>Last name</label><input type="text" placeholder="Smith"></div>
            </div>
            <div class="form-field" style="margin-bottom:20px"><label>Email</label><input type="email" placeholder="jane@company.com"></div>
            <div class="form-field" style="margin-bottom:20px"><label>Message</label><textarea rows="4" placeholder="How can we help?"></textarea></div>
            <button class="submit-btn">@(d.GetProperty("btnText").GetString())</button>
        </div>
    }
    else if (block.BlockType == "footer")
    {
        string brand = d.TryGetProperty("brand", out var b) ? b.GetString() : "Brand";
        string copy = d.TryGetProperty("copy", out var c) ? c.GetString() : "© 2026";
        string paddingVStr = d.TryGetProperty("paddingV", out var pv1) ? pv1.ToString() : "40";
        int paddingV_footer = 40; int.TryParse(paddingVStr, out paddingV_footer);

        <div class="b-footer" style="padding-top:@(paddingV_footer)px; padding-bottom:@(paddingV_footer)px">
            <div class="footer-brand">@(brand)</div>
            <div class="footer-links">
                @if(d.TryGetProperty("items", out var items) && items.ValueKind == JsonValueKind.Array)
                {
                    foreach(var item in items.EnumerateArray())
                    {
                        string label = item.TryGetProperty("label", out var l) ? l.GetString() : "";
                        string slug = item.TryGetProperty("slug", out var s) ? s.GetString() : "#";
                        string url = slug.StartsWith("http") || slug.StartsWith("/") || slug == "#" ? slug : $"/page/{slug}";
                        <a href="@url" style="color:inherit; text-decoration:none;">@label</a>
                    }
                }
                else
                {
                    <span>Privacy</span><span>Terms</span><span>Contact</span>
                }
            </div>
            <div class="footer-copy">@copy</div>
        </div>
    }
    else if (block.BlockType == "abouthighlights")
    {
        string heading = d.TryGetProperty("heading", out var h) ? h.GetString() : "";
        string subheading = d.TryGetProperty("subheading", out var sh) ? sh.GetString() : "";
        string body = d.TryGetProperty("body", out var b) ? b.GetString() : "";
        string btnText = d.TryGetProperty("btnText", out var bt) ? bt.GetString() : "Know More";
        string btnLink = d.TryGetProperty("btnLink", out var bl) ? bl.GetString() : "#";
        string btnUrl = (btnLink.StartsWith("http") || btnLink.StartsWith("/") || btnLink == "#") ? btnLink : $"/page/{btnLink}";
        
        string leftBg = d.TryGetProperty("leftBg", out var lbg) ? lbg.GetString() : "#ffffff";
        string rightBg = d.TryGetProperty("rightBg", out var rbg) ? rbg.GetString() : "#a6111f";
        string textColorLeft = d.TryGetProperty("textColorLeft", out var tcl) ? tcl.GetString() : "#a6111f";
        string textColorRight = d.TryGetProperty("textColorRight", out var tcr) ? tcr.GetString() : "#ffffff";
        string btnBg = d.TryGetProperty("btnBg", out var bbg) ? bbg.GetString() : "#a6111f";
        string btnTextColor = d.TryGetProperty("btnTextColor", out var btc) ? btc.GetString() : "#ffffff";
        string iconColor = d.TryGetProperty("iconColor", out var ic) ? ic.GetString() : "#a6111f";
        string colWidth = d.TryGetProperty("colWidth", out var cw) ? cw.GetString() : "50-50";
        string alignItems = d.TryGetProperty("alignItems", out var ai) ? ai.GetString() : "center";
        string paddingVStr = d.TryGetProperty("paddingV", out var pv2) ? pv2.ToString() : "0";
        int paddingV = 0; int.TryParse(paddingVStr, out paddingV);

        var parts = (colWidth ?? "50-50").Split('-');
        string leftW = (parts.Length > 0 ? parts[0] : "50") + "%";
        string rightW = (parts.Length > 1 ? parts[1] : "50") + "%";

        <div class="b-abouthighlights" style="display:flex; flex-wrap:wrap; min-height:300px; padding-top:@(paddingV)px; padding-bottom:@(paddingV)px; align-items:@(alignItems == "center" ? "center" : "flex-start")">
            <div class="ah-left" style="flex: 0 0 @leftW; background:@leftBg; color:@textColorLeft; padding:60px 40px">
                <h1 style="color:@textColorLeft; margin-bottom:15px; font-size:32px">@heading</h1>
                <h3 style="color:@textColorLeft; margin-bottom:20px; font-size:18px">@subheading</h3>
                <p style="margin-bottom:30px; line-height:1.6; font-size:14px; color:#444">@body</p>
                <a href="@btnUrl" style="text-decoration:none">
                    <button class="ah-btn" style="background:@btnBg; color:@btnTextColor; border:none; padding:12px 30px; border-radius:30px; cursor:pointer; font-weight:500">@btnText</button>
                </a>
            </div>
            <div class="ah-right" style="flex: 0 0 @rightW; background:@rightBg; color:@textColorRight; padding:60px 40px">
                <div class="ah-items-list">
                    @if (d.TryGetProperty("items", out var highlightItems) && highlightItems.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var item in highlightItems.EnumerateArray())
                        {
                            string itIcon = item.TryGetProperty("icon", out var ii) ? ii.GetString() : "★";
                            string itTitle = item.TryGetProperty("title", out var it) ? it.GetString() : "";
                            string itDesc = item.TryGetProperty("desc", out var id) ? id.GetString() : "";
                            
                            <div class="ah-item">
                                <div class="ah-icon" style="background:@textColorRight; color:@iconColor">@itIcon</div>
                                <div class="ah-item-text">
                                    <h4 style="color:@textColorRight">@itTitle</h4>
                                    <p style="color:@textColorRight; opacity:0.9">@itDesc</p>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
    else if (block.BlockType == "servicegrid")
    {
        string heading = d.TryGetProperty("heading", out var h) ? h.GetString() : "What We Offer";
        string btnText = d.TryGetProperty("btnText", out var bt) ? bt.GetString() : "Know More";
        string btnLink = d.TryGetProperty("btnLink", out var bl) ? bl.GetString() : "#";
        string btnUrl = (btnLink.StartsWith("http") || btnLink.StartsWith("/") || btnLink == "#") ? btnLink : $"/page/{btnLink}";

        string paddingVStr = d.TryGetProperty("paddingV", out var pv) ? pv.ToString() : "80";
        int.TryParse(paddingVStr, out int paddingV);
        string bg = d.TryGetProperty("bg", out var bgc) ? bgc.GetString() : "#ffffff";
        string accentColor = d.TryGetProperty("accentColor", out var ac) ? ac.GetString() : "#a6111f";
        string titleColor = d.TryGetProperty("titleColor", out var tc) ? tc.GetString() : "#1a1a2e";
        string headerColor = d.TryGetProperty("headerColor", out var hcl) ? hcl.GetString() : "#a6111f";

        <div class="b-servicegrid" style="background:@bg; padding-top:@(paddingV)px; padding-bottom:@(paddingV)px">
            <div class="wwo-header"><h2 style="color:@titleColor">@heading<span style="background:@headerColor; display:block; width:60px; height:3px; margin:10px auto 0"></span></h2></div>
            <div class="wwo-grid">
                @if (d.TryGetProperty("items", out var items) && items.ValueKind == JsonValueKind.Array)
                {
                    foreach (var item in items.EnumerateArray())
                    {
                        string icon = item.TryGetProperty("icon", out var i) ? i.GetString() : "★";
                        string title = item.TryGetProperty("title", out var t) ? t.GetString() : "";
                        <div class="wwo-card" style="border-color:@(accentColor)22">
                            <div class="wwo-icon-wrap" style="background:@accentColor">@icon</div>
                            <h3 style="color:@titleColor">@title</h3>
                        </div>
                    }
                }
            </div>
            <a href="@btnUrl" class="wwo-btn" style="background:@accentColor">@btnText</a>
        </div>
    }
    else if (block.BlockType == "footer2")
    {
        string brand = d.TryGetProperty("brand", out var b) ? b.GetString() : "Brand";
        string tagline = d.TryGetProperty("tagline", out var tl) ? tl.GetString() : "";
        string logoImage = d.TryGetProperty("logoImage", out var limg) ? limg.GetString() : "";
        string copy = d.TryGetProperty("copy", out var c) ? c.GetString() : "";
        string bg = d.TryGetProperty("bg", out var bgc) ? bgc.GetString() : "#12121e";
        string textColor = d.TryGetProperty("textColor", out var tc) ? tc.GetString() : "#ffffff";
        string accent = d.TryGetProperty("accentColor", out var ac) ? ac.GetString() : "#a6111f";
        bool showNewsletter = true;
        if (d.TryGetProperty("showNewsletter", out var sn)) {
            showNewsletter = sn.ValueKind == JsonValueKind.True || (sn.ValueKind == JsonValueKind.String && sn.GetString() == "true");
        }
        string colLayout = d.TryGetProperty("colLayout", out var cl) ? cl.GetString() : "4";
        
        <div class="b-footer2" style="background:@bg; color:@textColor">
            <div class="f2-inner">
                <div class="f2-grid-@(colLayout)">
                    <div class="f2-col">
                        @if (!string.IsNullOrEmpty(logoImage)) {
                            <img src="@logoImage" alt="@brand" style="max-height:48px; width:auto; object-fit:contain; margin-bottom:14px; display:block">
                        } else {
                            <div class="f2-brand" style="color:@textColor">@brand</div>
                        }
                        <p style="color:@(textColor)80; font-size:13px; line-height:1.7; max-width:240px">@tagline</p>
                    </div>

                    <div class="f2-col">
                        <div class="f2-col-title" style="color:@textColor; border-color:@accent">QUICK LINKS</div>
                        <ul class="f2-links-list">
                            @if (d.TryGetProperty("quickLinks", out var ql) && ql.ValueKind == JsonValueKind.Array)
                            {
                                foreach (var link in ql.EnumerateArray())
                                {
                                    string label = link.TryGetProperty("label", out var lab) ? lab.GetString() : "";
                                    string lslug = link.TryGetProperty("slug", out var ls) ? ls.GetString() : "#";
                                    string url = (lslug.StartsWith("http") || lslug.StartsWith("/") || lslug == "#") ? lslug : $"/page/{lslug}";
                                    <li><a href="@url" style="color:@(textColor)80; text-decoration:none" class="f2-link">@label</a></li>
                                }
                            }
                        </ul>
                    </div>

                    <div class="f2-col">
                        @if (d.TryGetProperty("contactLinks", out var clks) && clks.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var contact in clks.EnumerateArray())
                            {
                                string cLabel = contact.TryGetProperty("label", out var clab) ? clab.GetString() : "CONTACT US";
                                string cAddress = contact.TryGetProperty("address", out var caddr) ? caddr.GetString() : "";
                                string cEmail = contact.TryGetProperty("email", out var cem) ? cem.GetString() : "";
                                string cPhone = contact.TryGetProperty("phone", out var cph) ? cph.GetString() : "";

                                <div class="f2-contact-col">
                                    <div class="f2-col-title" style="color:@textColor; border-color:@accent">@cLabel</div>
                                    @if (!string.IsNullOrEmpty(cAddress)) {
                                        <div class="f2-contact-row">
                                            <span class="f2-contact-icon" style="color:@accent">📍</span>
                                            <span style="color:@(textColor)80">@cAddress</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(cEmail)) {
                                        <div class="f2-contact-row">
                                            <span class="f2-contact-icon" style="color:@accent">✉</span>
                                            <a href="mailto:@cEmail" style="color:@accent; text-decoration:none">@cEmail</a>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(cPhone)) {
                                        <div class="f2-contact-row">
                                            <span class="f2-contact-icon" style="color:@accent">📞</span>
                                            <span style="color:@(textColor)80">@cPhone</span>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>

                    @if (showNewsletter) {
                        <div class="f2-col">
                            <div class="f2-col-title" style="color:@textColor; border-color:@accent">NEWSLETTER</div>
                            <p style="color:@(textColor)80; font-size:13px; line-height:1.6; margin-bottom:16px">Stay updated with our latest news and insights.</p>
                            <div class="f2-newsletter-row">
                                <input type="email" placeholder="@(d.TryGetProperty("newsletterPlaceholder", out var nlp) ? nlp.GetString() : "Email Address")" 
                                       class="f2-newsletter-input" 
                                       style="background:@(bg == "#ffffff" ? "#f4f4f2" : "rgba(255,255,255,0.07)"); color:@textColor; border-color:rgba(255,255,255,0.12)">
                                <button class="f2-newsletter-btn" style="background:@accent">@(d.TryGetProperty("newsletterBtnText", out var nbt) ? nbt.GetString() : "Join")</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="f2-bottom" style="border-color:rgba(255,255,255,0.08)">
                <span style="color:@(textColor)50; font-size:12px">@copy</span>
            </div>
        </div>
    }
}

<script>
    let sliderStates = {};

    function initSliders() {
        document.querySelectorAll('.b-testimonial-slider').forEach(slider => {
            const id = slider.id.replace('slider-', '');
            if (!sliderStates[id]) {
                sliderStates[id] = { current: 0, interval: null };
            }
            updateSliderView(id);
            startSliderAuto(id);
            
            slider.onmouseenter = () => stopSliderAuto(id);
            slider.onmouseleave = () => startSliderAuto(id);
        });
    }

    function jumpSlider(id, index) {
        if (!sliderStates[id]) return;
        sliderStates[id].current = index;
        updateSliderView(id);
        startSliderAuto(id);
    }

    function moveSlider(id, dir) {
        const slider = document.getElementById(`slider-${id}`);
        if (!slider) return;
        const items = slider.querySelectorAll('.ts-item');
        const visibleCount = getVisibleCount();
        const max = Math.max(0, items.length - visibleCount);
        
        if (!sliderStates[id]) sliderStates[id] = { current: 0, interval: null };
        
        sliderStates[id].current += dir;
        if (sliderStates[id].current > max) sliderStates[id].current = 0;
        if (sliderStates[id].current < 0) sliderStates[id].current = max;
        
        updateSliderView(id);
    }

    function updateSliderView(id) {
        const slider = document.getElementById(`slider-${id}`);
        if (!slider) return;
        
        const track = slider.querySelector(`.ts-track`);
        const dots = slider.querySelectorAll(`.ts-dot`);
        const state = sliderStates[id];
        
        const item = track.querySelector(`.ts-item`);
        if (!item) return;
        
        const gap = 30;
        const itemWidth = item.offsetWidth;
        const moveX = state.current * (itemWidth + gap);
        
        track.style.transform = `translateX(-${moveX}px)`;
        
        dots.forEach((dot, i) => {
            dot.classList.toggle('active', i === state.current);
        });
    }

    function startSliderAuto(id) {
        stopSliderAuto(id);
        sliderStates[id].interval = setInterval(() => moveSlider(id, 1), 5000);
    }

    function stopSliderAuto(id) {
        if (sliderStates[id] && sliderStates[id].interval) {
            clearInterval(sliderStates[id].interval);
        }
    }

    function getVisibleCount() {
        const w = window.innerWidth;
        if (w > 992) return 2;
        return 1;
    }

    window.addEventListener('resize', () => {
        Object.keys(sliderStates).forEach(id => updateSliderView(id));
    });

    document.addEventListener('DOMContentLoaded', initSliders);
</script>

</body>
</html>
