                <div class="f2-grid-@(colLayout)">
                    <div class="f2-col">
                        @if (!string.IsNullOrEmpty(logoImage)) {
                            <img src="@logoImage" alt="@brand" style="max-height:48px; width:auto; object-fit:contain; margin-bottom:14px; display:block">
                        } else {
                            <div class="f2-brand" style="color:@(d.TryGetProperty("headerColor", out var hc) ? hc.GetString() : textColor)">@brand</div>
                        }
                        <p style="color:@(textColor)80; font-size:13px; line-height:1.7; max-width:240px">@tagline</p>
                    </div>

                    <div class="f2-col">
                        <div class="f2-col-title" style="color:@(d.TryGetProperty("headerColor", out var hc2) ? hc2.GetString() : textColor); border-color:@accent">QUICK LINKS</div>
                        <ul class="f2-links-list">
                            @if (d.TryGetProperty("quickLinks", out var ql) && ql.ValueKind == JsonValueKind.Array)
                            {
                                foreach (var link in ql.EnumerateArray())
                                {
                                    string label = link.TryGetProperty("label", out var lab) ? lab.GetString() : "";
                                    string lslug = link.TryGetProperty("slug", out var ls) ? ls.GetString() : "#";
                                    string url = (lslug.StartsWith("http") || lslug.StartsWith("/") || lslug == "#") ? lslug : $"/page/{lslug}";
                                    <li><a href="@url" style="color:@(textColor)80; text-decoration:none" class="f2-link">@label</a></li>
                                }
                            }
                        </ul>
                    </div>

                    <div class="f2-col">
                        @if (d.TryGetProperty("contactLinks", out var clks) && clks.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var contact in clks.EnumerateArray())
                            {
                                string cLabel = contact.TryGetProperty("label", out var clab) ? clab.GetString() : "CONTACT US";
                                string cAddress = contact.TryGetProperty("address", out var caddr) ? caddr.GetString() : "";
                                string cEmail = contact.TryGetProperty("email", out var cem) ? cem.GetString() : "";
                                string cPhone = contact.TryGetProperty("phone", out var cph) ? cph.GetString() : "";

                                <div class="f2-contact-col">
                                    <div class="f2-col-title" style="color:@(d.TryGetProperty("headerColor", out var hc3) ? hc3.GetString() : textColor); border-color:@accent">@cLabel</div>
                                    @if (!string.IsNullOrEmpty(cAddress)) {
                                        <div class="f2-contact-row">
                                            <span class="f2-contact-icon" style="color:@accent">📍</span>
                                            <span style="color:@(textColor)80">@cAddress</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(cEmail)) {
                                        <div class="f2-contact-row">
                                            <span class="f2-contact-icon" style="color:@accent">✉</span>
                                            <a href="mailto:@cEmail" style="color:@accent; text-decoration:none">@cEmail</a>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(cPhone)) {
                                        <div class="f2-contact-row">
                                            <span class="f2-contact-icon" style="color:@accent">📞</span>
                                            <span style="color:@(textColor)80">@cPhone</span>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>

                    @if (showNewsletter) {
                        <div class="f2-col">
                            <div class="f2-col-title" style="color:@(d.TryGetProperty("headerColor", out var hc4) ? hc4.GetString() : textColor); border-color:@accent">NEWSLETTER</div>
                            <p style="color:@(textColor)80; font-size:13px; line-height:1.6; margin-bottom:16px">Stay updated with our latest news and insights.</p>
                            <div class="f2-newsletter-row">
                                <input type="email" placeholder="@(d.TryGetProperty("newsletterPlaceholder", out var nlp) ? nlp.GetString() : "Email Address")" 
                                       class="f2-newsletter-input" 
                                       style="background:@(bg == "#ffffff" ? "#f4f4f2" : "rgba(255,255,255,0.07)"); color:@textColor; border-color:rgba(255,255,255,0.12)">
                                <button class="f2-newsletter-btn" style="background:@(d.TryGetProperty("btnColor", out var bc) ? bc.GetString() : accent); color:@(d.TryGetProperty("btnTextColor", out var btc) ? btc.GetString() : "#ffffff")">@(d.TryGetProperty("newsletterBtnText", out var nbt) ? nbt.GetString() : "Join")</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="f2-bottom" style="border-color:rgba(255,255,255,0.08)">
                <span style="color:@(textColor)50; font-size:12px">@copy</span>
            </div>
        </div>
    }
    else if (block.BlockType == "locations")
    {
        string heading = d.TryGetProperty("heading", out var h) ? h.GetString() : "Our Locations";
        string bg = d.TryGetProperty("bg", out var bgColor) ? bgColor.GetString() : "#ffffff";
        string accent = d.TryGetProperty("accentColor", out var acc) ? acc.GetString() : "#a6111f";
        string paddingVStr = d.TryGetProperty("paddingV", out var pv) ? pv.ToString() : "80";
        int paddingV = 80; int.TryParse(paddingVStr, out paddingV);

        <div class="b-locations" style="background:@bg; padding-top:@(paddingV)px; padding-bottom:@(paddingV)px">
            <div class="loc-inner">
                <h1 class="loc-main-heading" style="color:@accent">@heading</h1>
                <div class="loc-list">
                    @if (d.TryGetProperty("items", out var locItems) && locItems.ValueKind == JsonValueKind.Array)
                    {
                        int index = 0;
                        foreach (var item in locItems.EnumerateArray())
                        {
                            string title = item.TryGetProperty("title", out var it) ? it.GetString() : "";
                            string address = item.TryGetProperty("address", out var iaddr) ? iaddr.GetString() : "";
                            string mapEmbed = item.TryGetProperty("mapEmbed", out var m) ? m.GetString() : "";
                            string phone = item.TryGetProperty("phone", out var p) ? p.GetString() : "";
                            string email = item.TryGetProperty("email", out var e) ? e.GetString() : "";
                            string fax = item.TryGetProperty("fax", out var f) ? f.GetString() : "";
                            string tollFree = item.TryGetProperty("tollFree", out var tf) ? tf.GetString() : "";

                            <div class="loc-item @(index == 0 ? "active" : "")">
                                <div class="loc-header" onclick="this.parentElement.classList.toggle('active')">
                                    <h3>@title</h3>
                                    <div class="loc-toggle-icon">▼</div>
                                </div>
                                <div class="loc-content">
                                    <div class="loc-flex">
                                        <div class="loc-map">
                                            @if(!string.IsNullOrEmpty(mapEmbed)) {
                                                <iframe src="@mapEmbed" width="100%" height="350" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                                            } else {
                                                <div class="loc-map-placeholder">Map URL needed</div>
                                            }
                                        </div>
                                        <div class="loc-details">
                                            <h3>@title</h3>
                                            <div class="loc-detail-row">
                                                <span class="loc-icon" style="color:@accent">📍</span>
                                                <span>@address</span>
                                            </div>
                                            @if(!string.IsNullOrEmpty(phone)) {
                                                <div class="loc-detail-group">
                                                    <div class="loc-detail-label">Phone Number</div>
                                                    <div class="loc-detail-row"><span class="loc-icon" style="color:@accent">📞</span><span>: @phone</span></div>
                                                </div>
                                            }
                                            @if(!string.IsNullOrEmpty(fax)) {
                                                <div class="loc-detail-group">
                                                    <div class="loc-detail-label">Fax</div>
                                                    <div class="loc-detail-row"><span class="loc-icon" style="color:@accent">📠</span><span>: @fax</span></div>
                                                </div>
                                            }
                                            @if(!string.IsNullOrEmpty(tollFree)) {
                                                <div class="loc-detail-group">
                                                    <div class="loc-detail-label">Toll Free</div>
                                                    <div class="loc-detail-row"><span class="loc-icon" style="color:@accent">📞</span><span>: @tollFree</span></div>
                                                </div>
                                            }
                                            @if(!string.IsNullOrEmpty(email)) {
                                                <div class="loc-detail-group">
                                                    <div class="loc-detail-label">Email</div>
                                                    <div class="loc-detail-row"><span class="loc-icon" style="color:@accent">✉</span><a href="mailto:@email" style="color:inherit;text-decoration:none">: @email</a></div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            index++;
                        }
                    }
                </div>
            </div>
        </div>
    }
}

<script>
    let sliderStates = {};

    function initSliders() {
        document.querySelectorAll('.b-testimonial-slider, .b-client-slider, .b-heropro').forEach(slider => {
            const id = slider.id.replace('slider-', '');
            if (!sliderStates[id]) {
                sliderStates[id] = { current: 0, interval: null };
            }
            updateSliderView(id);

            const autoScrollStr = slider.getAttribute('data-autoscroll');
            if (autoScrollStr !== 'false') {
                startSliderAuto(id);
                slider.onmouseenter = () => stopSliderAuto(id);
                slider.onmouseleave = () => startSliderAuto(id);
            } else {
                stopSliderAuto(id);
                slider.onmouseenter = null;
                slider.onmouseleave = null;
            }
        });
    }

    function jumpSlider(id, index) {
        if (!sliderStates[id]) return;
        sliderStates[id].current = index;
        updateSliderView(id);
        const slider = document.getElementById(`slider-${id}`);
        if(slider && slider.getAttribute('data-autoscroll') !== 'false') {
            startSliderAuto(id);
        }
    }

    function moveSlider(id, dir) {
        const slider = document.getElementById(`slider-${id}`);
        if (!slider) return;
        const isClient = slider.classList.contains('b-client-slider');
        const isHero = slider.classList.contains('b-heropro');
        const prefix = isHero ? 'hp' : (isClient ? 'cs' : 'ts');
        const items = slider.querySelectorAll(`.${prefix}-item, .${prefix}-slide`);
        const visibleCount = isHero ? 1 : getVisibleCount(isClient ? 'clientslider' : 'testimonial');
        const max = Math.max(0, items.length - visibleCount);
        
        if (!sliderStates[id]) sliderStates[id] = { current: 0, interval: null };
        
        sliderStates[id].current += dir;
        if (sliderStates[id].current > max) sliderStates[id].current = 0;
        if (sliderStates[id].current < 0) sliderStates[id].current = max;
        
        updateSliderView(id);
    }

    function updateSliderView(id) {
        const slider = document.getElementById(`slider-${id}`);
        if (!slider) return;
        const isClient = slider.classList.contains('b-client-slider');
        const isHero = slider.classList.contains('b-heropro');
        const prefix = isHero ? 'hp' : (isClient ? 'cs' : 'ts');
        
        const track = slider.querySelector(`.${prefix}-track`);
        const dots = slider.querySelectorAll(`.${prefix}-dot`);
        const state = sliderStates[id];
        
        const item = track.querySelector(`.${prefix}-item, .${prefix}-slide`);
        if (!item) return;
        
        const gap = isHero ? 0 : 30; // No gap for full-screen hero slider
        const itemWidth = item.offsetWidth;
        const moveX = state.current * (itemWidth + gap);
        
        track.style.transform = `translateX(-${moveX}px)`;
        
        dots.forEach((dot, i) => {
            dot.classList.toggle('active', i === state.current);
        });
    }

    function startSliderAuto(id) {
        stopSliderAuto(id);
        sliderStates[id].interval = setInterval(() => moveSlider(id, 1), 5000);
    }

    function stopSliderAuto(id) {
        if (sliderStates[id] && sliderStates[id].interval) {
            clearInterval(sliderStates[id].interval);
            sliderStates[id].interval = null;
        }
    }

    function getVisibleCount(type) {
        const w = window.innerWidth;
        if (type === 'clientslider') {
            const slider = document.querySelector(`.b-client-slider`);
            let dCols = 4;
            if (slider) dCols = parseInt(slider.getAttribute('data-cols')) || 4;

            if (w > 992) return dCols;
            if (w > 768) return Math.min(3, dCols);
            if (w > 480) return Math.min(2, dCols);
            return 1;
        }
        if (w > 992) return 2;
        return 1;
    }

    window.addEventListener('resize', () => {
        Object.keys(sliderStates).forEach(id => updateSliderView(id));
    });

    document.addEventListener('DOMContentLoaded', initSliders);
</script>

<script src="~/js/site.js"></script>
</body>
</html>
